# Supabase — cree un proyecto en supabase.com (plan gratuito).
# Copie los valores desde Project Settings → API:
#   - Project URL            → NEXT_PUBLIC_SUPABASE_URL
#   - Publishable key (nueva)→ NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   - Secret key (nueva, servidor) → SUPABASE_SECRET_KEY
# Las keys legacy (anon / service_role) siguen funcionando; la app usa
# primero la nueva y usa la legacy como respaldo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: solo el contenido del token de verificación (no la etiqueta HTML).
# Permite verificar una propiedad de prefijo de URL; para una propiedad de dominio
# en Google Search Console use el registro DNS que indique Google.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Audiencia: integración Statsig gratuita en Vercel. Solo mide production.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=
# Console API Key de solo lectura, sin permiso de acceso a otras claves. Solo servidor.
STATSIG_CONSOLE_API_KEY=

# Avisos automáticos de moderación; avisos opcionales de edición/eliminación. Solo servidor.
# Sin API key, los avisos de moderación permanecen en la cola y no se envían.
RESEND_API_KEY=
# Opcional: por defecto usa este remitente; verifique su dominio en Resend.
RESEND_FROM_EMAIL="La Protectora del Alquiler <no-reply@auth.protectoradelalquiler.com>"

# Worker de avisos: secreto aleatorio de al menos 32 bytes, solo servidor.
# En Supabase Cron, npm run avisos:cron -- --aplicar guarda este secreto en Vault
# y programa GET /api/avisos cada 5 minutos. Ver docs/runbooks/activacion.md.
CRON_SECRET=

# Para scripts de administración (aplicar-esquema / migrar-legacy).
# En Vercel, la integración Supabase también proporciona POSTGRES_URL;
# los scripts la detectan automáticamente.
# Settings → Database → Connection string → URI → "Session" (pooler, puerto 5432).
# NOTA: en proyectos nuevos el host "Direct" (db.…) a veces no resuelve en DNS;
# el pooler siempre funciona. Si usa Postgres local, deje vacío o use el host local.
DATABASE_URL=
# Los scripts verifican TLS y el nombre del servidor. La CA pública de Supabase
# se incluye en el despliegue; sslmode=require en la URL se normaliza a verify-full.
# Para otra CA, use sslrootcert=/ruta/al/certificado.crt en la URL.
# Opcional: DATABASE_SSL=false solo para localhost / 127.0.0.1 / ::1.

# Ingreso con Facebook. Déjelo vacío hasta terminar la guía
# docs/runbooks/facebook-signin.md. Con el valor 1 aparecen
# «Continuar con Facebook» y «Conectar Facebook».
AUTH_FACEBOOK=

# El mismo App Secret de Meta que se pega en Supabase. Solo servidor.
# Verifica la solicitud firmada de eliminación. Sin este valor, esa ruta responde 404.
FACEBOOK_APP_SECRET=

# MySQL legacy (fuente de la migración)
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DB=laprotec_laprotectora
